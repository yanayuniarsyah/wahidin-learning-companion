    "items": [
        {
            "id": 1,
            "construct_id": 1,
            "text": "Saya segera menyiapkan buku dan alat tulis ketika waktu belajar dimulai.",
            "is_reverse": 0
        },
        {
            "id": 2,
            "construct_id": 1,
            "text": "Saya butuh waktu lama untuk benar-benar mulai mengerjakan soal.",
            "is_reverse": 1
        },
        {
            "id": 3,
            "construct_id": 2,
            "text": "Saya menyelesaikan satu bagian tugas sebelum beralih ke aktivitas lain.",
            "is_reverse": 0
        },
        {
            "id": 4,
            "construct_id": 2,
            "text": "Perhatian saya mudah teralihkan oleh hal lain saat sedang belajar.",
            "is_reverse": 1
        },
        {
            "id": 5,
            "construct_id": 3,
            "text": "Saya membaca instruksi soal dengan teliti sebelum mulai menjawab.",
            "is_reverse": 0
        },
        {
            "id": 6,
            "construct_id": 3,
            "text": "Saya langsung mengerjakan soal tanpa melihat contoh cara penyelesaian.",
            "is_reverse": 1
        },
        {
            "id": 7,
            "construct_id": 4,
            "text": "Saya mencoba mengerjakan soal sendiri terlebih dahulu sebelum bertanya.",
            "is_reverse": 0
        },
        {
            "id": 8,
            "construct_id": 4,
            "text": "Saya harus selalu diingatkan agar segera menyelesaikan tugas.",
            "is_reverse": 1
        },
        {
            "id": 9,
            "construct_id": 5,
            "text": "Jika menemui soal sulit, saya mencoba membacanya sekali lagi dengan lebih pelan.",
            "is_reverse": 0
        },
        {
            "id": 10,
            "construct_id": 5,
            "text": "Saya langsung berhenti dan menyerah jika soalnya terlihat susah.",
            "is_reverse": 1
        },
        {
            "id": 11,
            "construct_id": 6,
            "text": "Saya mengecek kembali hasil pekerjaan saya sebelum menyatakannya selesai.",
            "is_reverse": 0
        },
        {
            "id": 12,
            "construct_id": 6,
            "text": "Saya bertanya kepada guru atau teman jika ada bagian yang benar-benar tidak saya pahami.",
            "is_reverse": 0
        },
        {
            "id": 13,
            "construct_id": 7,
            "text": "Saya memastikan tempat belajar saya rapi dari barang yang tidak diperlukan.",
            "is_reverse": 0
        },
        {
            "id": 14,
            "construct_id": 7,
            "text": "Saya terbiasa belajar sambil menyalakan televisi atau media sosial yang tidak terkait pelajaran.",
            "is_reverse": 1
        },
        {
            "id": 15,
            "construct_id": 8,
            "text": "Anak bersedia duduk di kursi belajarnya saat sesi dimulai",
            "is_reverse": 0
        },
        {
            "id": 16,
            "construct_id": 8,
            "text": "Anak meletakkan alat bermainnya saat pengajar memberi aba-aba waktu belajar",
            "is_reverse": 0
        },
        {
            "id": 17,
            "construct_id": 9,
            "text": "Anak mempertahankan kontak mata pada materi selama minimal 3 menit",
            "is_reverse": 0
        },
        {
            "id": 18,
            "construct_id": 9,
            "text": "Anak menunjuk atau menyentuh materi belajar saat diarahkan",
            "is_reverse": 0
        },
        {
            "id": 19,
            "construct_id": 10,
            "text": "Anak mengikuti instruksi tunggal dengan tepat",
            "is_reverse": 0
        },
        {
            "id": 20,
            "construct_id": 10,
            "text": "Anak memulai aktivitas setelah pengajar memberikan contoh atau panduan awal",
            "is_reverse": 0
        },
        {
            "id": 21,
            "construct_id": 11,
            "text": "Anak berusaha menyelesaikan satu aktivitas\/lembar kerja penuh sebelum berpindah",
            "is_reverse": 0
        },
        {
            "id": 22,
            "construct_id": 11,
            "text": "Anak tetap berada di area belajar hingga instruksi selesai diberikan",
            "is_reverse": 0
        },
        {
            "id": 23,
            "construct_id": 12,
            "text": "Anak memberikan gestur atau meminta bantuan secara langsung saat menemui hambatan",
            "is_reverse": 0
        },
        {
            "id": 24,
            "construct_id": 12,
            "text": "Anak tidak menangis atau melempar barang ketika kesulitan",
            "is_reverse": 0
        },
        {
            "id": 25,
            "construct_id": 13,
            "text": "Anak merespons arahan pengajar melalui ucapan singkat, anggukan, atau gelengan",
            "is_reverse": 0
        },
        {
            "id": 26,
            "construct_id": 13,
            "text": "Anak menirukan intruksi gerak atau suara dari pengajar",
            "is_reverse": 0
        },
        {
            "id": 27,
            "construct_id": 14,
            "text": "Anak mempertahankan posisi tubuh yang sesuai untuk belajar",
            "is_reverse": 0
        },
        {
            "id": 28,
            "construct_id": 14,
            "text": "Anak menggunakan alat tulis sesuai dengan fungsinya tanpa merusak",
            "is_reverse": 0
        },
        {
            "id": 29,
            "construct_id": 15,
            "text": "Anak meletakkan buku dan alat tulis di meja secara mandiri",
            "is_reverse": 0
        },
        {
            "id": 30,
            "construct_id": 15,
            "text": "Anak mulai fokus bekerja dalam waktu kurang dari 3 menit sejak duduk",
            "is_reverse": 0
        },
        {
            "id": 31,
            "construct_id": 16,
            "text": "Anak memusatkan perhatian pada lembar tugas selama minimal 10 menit tanpa terdistraksi",
            "is_reverse": 0
        },
        {
            "id": 32,
            "construct_id": 16,
            "text": "Anak menulis atau membaca materi tanpa peringatan lisan yang berulang",
            "is_reverse": 0
        },
        {
            "id": 33,
            "construct_id": 17,
            "text": "Anak melaksanakan instruksi majemuk (dua tahap atau lebih) dengan urutan yang benar",
            "is_reverse": 0
        },
        {
            "id": 34,
            "construct_id": 17,
            "text": "Anak mengaplikasikan cara pengerjaan yang baru saja dicontohkan",
            "is_reverse": 0
        },
        {
            "id": 35,
            "construct_id": 18,
            "text": "Anak menyelesaikan seluruh tugas di halamannya sebelum berpaling ke hal lain",
            "is_reverse": 0
        },
        {
            "id": 36,
            "construct_id": 18,
            "text": "Anak membalik halaman dan melanjutkan tugas secara mandiri",
            "is_reverse": 0
        },
        {
            "id": 37,
            "construct_id": 19,
            "text": "Anak mengangkat tangan atau bertanya lisan secara wajar saat tidak mengerti",
            "is_reverse": 0
        },
        {
            "id": 38,
            "construct_id": 19,
            "text": "Anak mencoba melihat kembali soal sebelum mencari bantuan pengajar",
            "is_reverse": 0
        },
        {
            "id": 39,
            "construct_id": 20,
            "text": "Anak menjawab pertanyaan pengajar dengan kalimat verbal yang relevan dengan topik",
            "is_reverse": 0
        },
        {
            "id": 40,
            "construct_id": 20,
            "text": "Anak menceritakan kembali secara singkat aktivitas yang baru dikerjakan",
            "is_reverse": 0
        },
        {
            "id": 41,
            "construct_id": 21,
            "text": "Anak tidak memainkan alat tulis di luar konteks pengerjaan tugas",
            "is_reverse": 0
        },
        {
            "id": 42,
            "construct_id": 21,
            "text": "Anak mempertahankan kerapian material belajar di mejanya",
            "is_reverse": 0
        },
        {
            "id": 43,
            "construct_id": 22,
            "text": "Anak langsung memeriksa daftar tugas atau materinya sesaat setelah tiba",
            "is_reverse": 0
        },
        {
            "id": 44,
            "construct_id": 22,
            "text": "Anak melakukan rutinitas awal belajar tanpa bimbingan pengajar",
            "is_reverse": 0
        },
        {
            "id": 45,
            "construct_id": 23,
            "text": "Anak mempertahankan fokus pada tugas utamanya walau ada pergerakan di sekitarnya",
            "is_reverse": 0
        },
        {
            "id": 46,
            "construct_id": 23,
            "text": "Anak secara proaktif membuat catatan atau menandai bagian penting",
            "is_reverse": 0
        },
        {
            "id": 47,
            "construct_id": 24,
            "text": "Anak membaca dan melaksanakan instruksi tertulis dengan benar",
            "is_reverse": 0
        },
        {
            "id": 48,
            "construct_id": 24,
            "text": "Anak langsung memperbaiki kesalahannya setelah mendapat petunjuk singkat",
            "is_reverse": 0
        },
        {
            "id": 49,
            "construct_id": 25,
            "text": "Anak secara sadar meninjau ulang pekerjaannya sebelum dianggap selesai",
            "is_reverse": 0
        },
        {
            "id": 50,
            "construct_id": 25,
            "text": "Anak memilah dan mengerjakan tugas yang tersisa tanpa teguran",
            "is_reverse": 0
        },
        {
            "id": 51,
            "construct_id": 26,
            "text": "Anak mencari referensi dari contoh soal yang ada sebelum bertanya pada pengajar",
            "is_reverse": 0
        },
        {
            "id": 52,
            "construct_id": 26,
            "text": "Anak tidak menunjukkan perilaku disruptif saat tugas terasa menantang",
            "is_reverse": 0
        },
        {
            "id": 53,
            "construct_id": 27,
            "text": "Anak memberikan pertanyaan balikan yang memperluas topik yang sedang dipelajari",
            "is_reverse": 0
        },
        {
            "id": 54,
            "construct_id": 27,
            "text": "Anak dapat menjelaskan proses berpikir atau cara menemukan jawaban",
            "is_reverse": 0
        },
        {
            "id": 55,
            "construct_id": 28,
            "text": "Anak mampu mengabaikan gangguan suara skala ringan dari luar area kerjanya",
            "is_reverse": 0
        },
        {
            "id": 56,
            "construct_id": 28,
            "text": "Anak mengembalikan perlengkapan belajar ke lokasi semula setelah usai",
            "is_reverse": 0
        }
    ]
}