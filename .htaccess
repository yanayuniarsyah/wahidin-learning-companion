# Protect sensitive files from direct HTTP access on Apache/cPanel
<FilesMatch "\.(db|json|bat|md|git|sh|log)$|^\.jwt_secret$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]
    RewriteRule ^api(/.*)?$ api.php [L,QSA]

    # Load the shared fixes on the dashboard and public certificate viewer.
    AddType text/javascript .js
    AddOutputFilterByType SUBSTITUTE text/html
    Substitute "s|</head>|<link rel=\"stylesheet\" href=\"/certificate-fixes.css?v=20260923\"><script src=\"/session-fixes.js?v=20260923\" defer></script></head>|i"
</IfModule>
